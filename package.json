{
  "name": "JooKoi-md-archive",
  "version": "1.0.0",
  "description": "Markdown knowledge tree POC built with Angular, NestJS, and SQLite.",
  "workspaces": [
    "web",
    "api"
  ],
  "scripts": {
    "build": "npm run build --workspace=web && npm run build --workspace=api",
    "build:web:prod": "node build-web.js",
    "build:api:prod": "npm run build --workspace=api",
    "start:web": "npm run start --workspace=web",
    "start:api": "npm run start:dev --workspace=api",
    "test": "npm run test --workspace=web && npm run test --workspace=api",
    "lint": "eslint . && npm run lint --workspace=web",
    "clean": "node -e \"require('fs').rmSync('.angular',{recursive:true,force:true});require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "watch": "concurrently \"npm:start:web\" \"npm:start:api\"",
    "build:clean": "npm run clean && npm install && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@types/node": "^24.0.0",
    "@typescript-eslint/utils": "^8.40.0",
    "concurrently": "^9.0.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "~3.6.2",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.40.0"
  },
  "private": true,
  "engines": {
    "node": ">=23.4"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.1": true,
    "lmdb@3.5.1": true,
    "msgpackr-extract@3.0.4": true,
    "unrs-resolver@1.12.2": true
  }
}
